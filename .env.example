# Copy this file to .env and fill in real values.
# python-dotenv loads it automatically when the app starts.

# Required in production; use a long random string.
SECRET_KEY="TruthLens-Key"

# MySQL connection string. Create the database first:
#   CREATE DATABASE truthlens_ai CHARACTER SET utf8mb4;
DATABASE_URL=mysql+pymysql://root:@localhost/truthlens_ai

# development | production
FLASK_ENV=development

# 1 enables the Flask debugger (never use in production).
FLASK_DEBUG=0
